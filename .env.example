# App
DATABASE_URL=sqlite:///./linkedin_pulse.db
APP_BASE_URL=http://localhost:8000
TIMEZONE=America/New_York
LOG_LEVEL=INFO

# Apify
# Create/copy your token from: https://console.apify.com/account/integrations
APIFY_TOKEN=

# LinkedIn scraper actor Tony selected:
# https://console.apify.com/actors/Wpp1BZ6yGWjySadk3/input
APIFY_ACTOR_ID=Wpp1BZ6yGWjySadk3

# Optional: use this later if we configure an Apify Task instead of direct actor runs.
APIFY_TASK_ID=

# Optional: use this if ingesting from an already-completed Apify dataset.
APIFY_DEFAULT_DATASET_ID=

# AI summaries
# Supported v0 values: mock, anthropic, openai
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AI_SUMMARY_MODEL=

# Scheduling
SCRAPE_INTERVAL_HOURS=12
DAILY_REPORT_HOUR_LOCAL=7
